# Compose 项目名（小写字母/数字/-/_），避免中文目录名导致 project name 为空
COMPOSE_PROJECT_NAME=lporienteering

# 数据库连接配置
DB_NAME=app
DB_USER=app
DB_PASSWORD=app_pwd
DB_ROOT_PASSWORD=root_pwd

# 后端 JWT 签名密钥，生产环境请修改为随机长字符串
JWT_SECRET=change_me_to_a_long_random_string

# 端口映射（本地端口冲突时可调整）
FRONTEND_PORT=28519
BACKEND_PORT=29519
DB_PORT=5432
